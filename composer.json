{
    "name": "phoenix1331/laravel-ai-headroom-ledger",
    "description": "Store and query per-request AI token usage and cost from Headroom.",
    "keywords": [
        "laravel",
        "ai",
        "llm",
        "headroom",
        "ledger",
        "tokens",
        "token-usage",
        "cost-tracking",
        "context-window",
        "usage-analytics",
        "laravel-ai-sdk"
    ],
    "homepage": "https://phoenix1331.github.io/laravel-ai-headroom-ledger",
    "license": "MIT",
    "authors": [
        {
            "name": "Darren Williams",
            "homepage": "https://github.com/phoenix1331"
        }
    ],
    "support": {
        "issues": "https://github.com/phoenix1331/laravel-ai-headroom-ledger/issues",
        "source": "https://github.com/phoenix1331/laravel-ai-headroom-ledger"
    },
    "require": {
        "php": "^8.3",
        "dragonmantank/cron-expression": "^3.4",
        "illuminate/console": "^12.0|^13.0",
        "illuminate/contracts": "^12.0|^13.0",
        "illuminate/database": "^12.0|^13.0",
        "illuminate/support": "^12.0|^13.0",
        "phoenix1331/laravel-ai-headroom": "^0.1"
    },
    "autoload": {
        "psr-4": {
            "Phoenix1331\\AiHeadroomLedger\\": "src/",
            "Phoenix1331\\AiHeadroomLedger\\Database\\Factories\\": "database/factories/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Phoenix1331\\AiHeadroomLedger\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Phoenix1331\\AiHeadroomLedger\\AiHeadroomLedgerServiceProvider"
            ],
            "aliases": {
                "Ledger": "Phoenix1331\\AiHeadroomLedger\\Facades\\Ledger"
            }
        }
    },
    "scripts": {
        "lint": "pint",
        "lint:test": "pint --test",
        "analyse": "phpstan analyse --memory-limit=1G",
        "test": "pest",
        "test:coverage": "pest --coverage --min=90",
        "check": [
            "@lint",
            "@analyse",
            "@test:coverage"
        ]
    },
    "scripts-descriptions": {
        "lint": "Fix code style with Pint",
        "lint:test": "Check code style without changing files",
        "analyse": "Run Larastan static analysis",
        "test": "Run the Pest test suite",
        "test:coverage": "Run the test suite with the 90% coverage gate",
        "check": "Run lint, analyse and coverage-gated tests in order"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.32",
        "orchestra/testbench": "^10.0|^11.0",
        "pestphp/pest": "^4.2|^5.0",
        "pestphp/pest-plugin-laravel": "^4.0|^5.0"
    }
}
